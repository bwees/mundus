    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.1.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "oazapfts": "^7.2.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
